{
    "executionRoleArn": "${EXECUTION_ROLE_ARN}",
    "containerDefinitions": [
        {
            "name": "${CONTAINER_NAME}",
            "image": "${IMAGE_CURRENT}",
            "essential": true,
            "portMappings": [
                {
                    "hostPort": 8080,
                    "protocol": "tcp",
                    "containerPort": 8080
                }
            ],
            "environment": [
                {
                    "name": "ENVIRONMENT",
                    "value": "GREEN"
                },
                {
                    "name": "VERSION",
                    "value": "${COMMIT_HASH}"
                },
                {
                    "name": "PORT",
                    "value": "8080"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-region": "ap-northeast-1",
                    "awslogs-stream-prefix": "ecs-task",
                    "awslogs-group": "/ecs-task/bg-deploy-test"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "networkMode": "awsvpc",
    "cpu": "256",
    "memory": "512",
    "family": "${TASK_FAMILY}"
}